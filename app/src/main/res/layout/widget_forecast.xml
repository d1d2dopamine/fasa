<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget. Plain views only: launchers cannot draw Compose. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="#97A6BA"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#E4EAF2"
        android:textSize="30sp"
        android:maxLines="1"
        android:text="@string/widget_none" />

    <TextView
        android:id="@+id/widget_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#4FD1C5"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_gate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#97A6BA"
        android:textSize="12sp"
        android:maxLines="1" />

</LinearLayout>
